{"id": "en_lost_forest_p2", "total": 68.89, "segments": [{"text": "Part two. Someone stares directly at Mark from inside the dark and terrifying wooden cabin doorway.", "start": 0.0, "end": 5.06}, {"text": "Mark stays completely frozen near the protective trees instead of walking toward the risky open doorway.", "start": 5.62, "end": 10.0}, {"text": "He remembers that searchers always start looking directly from your last known starting point.", "start": 10.54, "end": 14.08}, {"text": "Walking toward the distant cabin now would destroy his only chance of safe rescue tonight.", "start": 14.56, "end": 18.62}, {"text": "He stays put and waits patiently in the freezing snow while the bitter wind howls loudly.", "start": 19.3, "end": 23.08}, {"text": "One. Stop immediately because moving deeper into the dark forest makes rescue teams miss you.", "start": 22.984, "end": 28.34}, {"text": "Two. Think clearly and observe the freezing environment while waiting for help to arrive.", "start": 28.09, "end": 32.28}, {"text": "Three. Make yourself visible and audible so the search teams can find you quickly.", "start": 32.03, "end": 36.28}, {"text": "Mark crouches low near the huge tree and waves his bright jacket toward the clearing.", "start": 37.0, "end": 40.04}, {"text": "He blows 3 sharp whistle blasts into the freezing air as the universal distress signal.", "start": 40.56, "end": 44.24}, {"text": "He stays out of the wind and off the cold ground using branches beneath his boots.", "start": 44.7, "end": 47.86}, {"text": "The cabin door closes slowly as a rescue flashlight beam cuts through the falling snow.", "start": 48.54, "end": 52.02}, {"text": "Rescuers spot Mark right where he stayed near the trees exactly as survival rules require.", "start": 52.74, "end": 56.68}, {"text": "He made the smart choice by staying put instead of walking toward the dangerous cabin.", "start": 57.14, "end": 60.24}, {"text": "Always stay put when you are lost in the deep forest until help arrives safely.", "start": 60.76, "end": 63.96}, {"text": "Follow for a new scenario tomorrow.", "start": 64.42, "end": 65.74}], "words": [["Part", 0.0, 0.32], ["two.", 0.239, 0.478], ["Someone", 1.0, 1.28], ["stares", 1.28, 1.62], ["directly", 1.62, 2.02], ["at", 2.02, 2.26], ["Mark", 2.26, 2.36], ["from", 2.36, 2.56], ["inside", 2.56, 3.0], ["the", 3.0, 3.18], ["dark", 3.18, 3.38], ["and", 3.38, 3.62], ["terrifying", 3.62, 4.14], ["wooden", 4.14, 4.44], ["cabin", 4.44, 4.68], ["doorway.", 4.68, 5.06], ["Mark", 5.62, 5.86], ["stays", 5.86, 6.04], ["completely", 6.04, 6.52], ["frozen", 6.52, 6.9], ["near", 6.9, 7.06], ["the", 7.06, 7.16], ["protective", 7.16, 7.44], ["trees", 7.44, 7.78], ["instead", 7.78, 8.14], ["of", 8.14, 8.36], ["walking", 8.36, 8.6], ["toward", 8.6, 8.98], ["the", 8.98, 9.16], ["risky", 9.16, 9.4], ["open", 9.4, 9.62], ["doorway.", 9.62, 10.0], ["He", 10.54, 10.78], ["remembers", 10.78, 11.0], ["that", 11.0, 11.22], ["searchers", 11.22, 11.54], ["always", 11.54, 11.98], ["start", 11.98, 12.22], ["looking", 12.22, 12.44], ["directly", 12.44, 12.78], ["from", 12.78, 13.02], ["your", 13.02, 13.14], ["last", 13.14, 13.32], ["known", 13.32, 13.52], ["starting", 13.52, 13.86], ["point.", 13.86, 14.08], ["Walking", 14.56, 14.9], ["toward", 14.9, 15.16], ["the", 15.16, 15.32], ["distant", 15.32, 15.54], ["cabin", 15.54, 15.8], ["now", 15.8, 16.1], ["would", 16.1, 16.32], ["destroy", 16.32, 16.78], ["his", 16.78, 17.06], ["only", 17.06, 17.42], ["chance", 17.42, 17.72], ["of", 17.72, 17.9], ["safe", 17.9, 18.06], ["rescue", 18.06, 18.4], ["tonight.", 18.4, 18.62], ["He", 19.3, 19.52], ["stays", 19.52, 19.72], ["put", 19.72, 19.94], ["and", 19.94, 20.16], ["waits", 20.16, 20.32], ["patiently", 20.32, 20.78], ["in", 20.78, 20.96], ["the", 20.96, 21.04], ["freezing", 21.04, 21.26], ["snow", 21.26, 21.58], ["while", 21.58, 21.8], ["the", 21.8, 21.9], ["bitter", 21.9, 22.18], ["wind", 22.18, 22.4], ["howls", 22.4, 22.78], ["loudly.", 22.78, 23.08], ["One.", 22